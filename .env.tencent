# GEOFlow 腾讯云 PM2 部署环境（/opt/geoflow/.env）
APP_NAME=GEOworkflow
APP_ENV=production
APP_KEY=base64:ep7csiGcyd9/nT+YHP+veBYe/jktfrSjbKtzb8tNAVI=
APP_DEBUG=false
APP_URL=http://111.230.58.40:3033
TRUSTED_PROXIES=*
BOOST_BROWSER_LOGS_WATCHER=false
APP_TIMEZONE=Asia/Shanghai

SITE_NAME="智能GEO内容系统"
SITE_FULL_NAME="GEO+AI内容生成系统"
SITE_URL="${APP_URL}"
ADMIN_BASE_PATH=geo_admin
GEOFLOW_PUBLIC_LOCALE=zh_CN

GEOFLOW_ADMIN_USERNAME=admin
GEOFLOW_ADMIN_EMAIL=admin@example.com
GEOFLOW_ADMIN_PASSWORD=Geoflow@2026!

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=geo_flow
DB_USERNAME=geo_user
DB_PASSWORD=geo_password_tencent

SESSION_DRIVER=file
SESSION_LIFETIME=43200

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=geoflow-reverb-app
REVERB_APP_KEY=geoflow-reverb-key
REVERB_APP_SECRET=geoflow-reverb-secret-tencent
