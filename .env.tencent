REVERB_PORT=3034
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=3034

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6380
REDIS_QUEUE_RETRY_AFTER=360

LOG_CHANNEL=daily
LOG_LEVEL=warning

GEO_EVAL_ENABLED=true
GEO_EVAL_MOCK_MODE=true
GEO_EVAL_GATE_ENABLED=true
GEO_EVAL_GATE_ROLLOUT_PERCENT=100
GEO_EVAL_ON_UNAVAILABLE=skip

GEOFLOW_CONTENT_AGENT_BACKEND=internal

VITE_APP_NAME="${APP_NAME}"
