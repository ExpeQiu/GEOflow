# geo-stack 一键部署环境（Compose 容器内主机名）
# 复制为 .env 后按需修改。勿把生产密钥提交进仓。

GEOFLOW_SYNC_TOKEN=dev-geoweb-sync-token
GWEB_REVALIDATE_SECRET=gweb-revalidate-2026-prod
NEXTAUTH_SECRET=change-me-techstore-docker

# GEOFlow API 容器访问 GEOweb（同一 docker 网络）
GEOWEB_BASE_URL=http://geoweb:3000
GEOWEB_SYNC_ENABLED=true

# 浏览器入口（宿主机端口）
API_PORT=18081
ADMIN_PORT=13001
TECHSTORE_PORT=3001
GEOWEB_PORT=3070
