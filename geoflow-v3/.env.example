# GEOFlow v3
APP_NAME=GEOFlow
APP_VERSION=3.0.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://geo_user:geo_password@postgres:5432/geo_flow
DATABASE_URL_SYNC=postgresql://geo_user:geo_password@postgres:5432/geo_flow
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production-v3
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
API_TOKEN_DEFAULT_TTL_DAYS=30

GEOFLOW_TECH_BRAND_MODE=true
GEOFLOW_PUBLIC_SITE_ENABLED=false
GEO_EVAL_ENABLED=true
GEO_EVAL_WIKI_GATE_ENABLED=true
GEO_EVAL_SIMULATION_PASS_SCORE=0.55
GEO_EVAL_AUDIT_PASS_SCORE=0.60
# true=本地 Mock；生产/真实生成必须 false，并在 Admin 配置 Chat(+Embedding)
AI_MOCK_MODE=false
PDF_OCR_ENABLED=false

# --- C 端金标辅轨（Playwright；可选 pip install -e '.[cend]'）---
# CEND_MOCK_MODE=true
# CEND_HEADLESS=true
# CEND_SCAN_PLATFORMS=yuanbao
# CEND_PROFILE_ROOT=/Users/you/Library/Application Support/geoflow-cend
# CEND_ARTIFACT_ROOT=/Users/you/Library/Application Support/geoflow-cend/artifacts

# --- 可选：scripts/bootstrap_ai_from_env.py 从环境注入 Admin 模型 ---
# ZHIPU_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 官方技术发布站 = GEOweb（Gweb 为独立项目前台，不在此对接）
GEOWEB_BASE_URL=http://127.0.0.1:3070
GEOWEB_SYNC_TOKEN=dev-geoweb-sync-token
GEOWEB_SYNC_ENABLED=true

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

API_PORT=18081
ADMIN_PORT=13001
