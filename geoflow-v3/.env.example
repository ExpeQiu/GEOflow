# GEOFlow v3
APP_NAME=GEOFlow
APP_VERSION=3.0.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://geo_user:geo_password@postgres:5432/geo_flow
DATABASE_URL_SYNC=postgresql://geo_user:geo_password@postgres:5432/geo_flow
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production-v3
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
API_TOKEN_DEFAULT_TTL_DAYS=30
# 生产务必 ALLOW_INSECURE_JWT=false 且 JWT_SECRET ≥24 位随机串
ALLOW_INSECURE_JWT=true
CONTENT_AGENT_CALLBACK_SECRET=dev-callback-secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13001,http://localhost:13001
# 可选：单独指定 AI Key 加密材料，默认回退 JWT_SECRET
# API_KEY_ENCRYPTION_KEY=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

GEOFLOW_TECH_BRAND_MODE=true
GEOFLOW_PUBLIC_SITE_ENABLED=false
GEO_EVAL_ENABLED=true
GEO_EVAL_WIKI_GATE_ENABLED=true
GEO_EVAL_SIMULATION_PASS_SCORE=0.55
GEO_EVAL_AUDIT_PASS_SCORE=0.60
# true=本地 Mock；生产/真实生成必须 false，并在 Admin 配置 Chat(+Embedding)
AI_MOCK_MODE=false

# --- LLM API 资源 ---
# Admin「AI 模型」页可切换：vendor=供应商直连 / geely=企业 AI Gateway / auto=跟随本项
# 企业推荐：LLM_GATEWAY_MODE=enterprise-gateway + ENTERPRISE_AI_GATEWAY_API_KEY
LLM_GATEWAY_MODE=enterprise-gateway

# --- 企业 AI Gateway（公司级 · 参考 Geely 开发指南/企业AI-API直连网关.md）---
ENTERPRISE_AI_GATEWAY_API_KEY=
ENTERPRISE_AI_TEXT_BASE_URL=https://ai-gateway-office.zeekrlife.com/v1
ENTERPRISE_AI_ANTHROPIC_BASE_URL=https://ai-gateway-office.zeekrlife.com/anthropic
ENTERPRISE_AI_TEXT_MODEL=gpt-4o
ENTERPRISE_AI_EMBED_MODEL=text-embedding-v3
# AIGC 主机（文生图/视频，GEOFlow 正文链路暂未使用）
ENTERPRISE_AI_GATEWAY_BASE_URL=https://ai-gateway.zeekrlife-test.com
ENTERPRISE_AI_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ENTERPRISE_AI_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
ENTERPRISE_AI_VISION_MODEL=qwen3-vl-plus

# --- Lobster 遗留（Eva 同学本地 :56045，无企业 Key 时 dev 用）---
# LLM_GATEWAY_MODE=lobster
LOBSTER_PROXY_BASE=http://127.0.0.1:56045
LOBSTER_PROXY_TOKEN=
LOBSTER_API_ROOT=v1
PDF_OCR_ENABLED=false

# --- C 端金标辅轨（Playwright；可选 pip install -e '.[cend]'）---
# CEND_MOCK_MODE=true
# CEND_HEADLESS=true
# CEND_SCAN_PLATFORMS=yuanbao
# CEND_PROFILE_ROOT=/Users/you/Library/Application Support/geoflow-cend
# CEND_ARTIFACT_ROOT=/Users/you/Library/Application Support/geoflow-cend/artifacts

# --- 可选：scripts/bootstrap_ai_from_env.py 从环境注入 Admin 模型 ---
# ZHIPU_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_THINKING_MODEL=deepseek-chat
# DOUBAO_API_KEY=
# ARK_API_KEY=
# DOUBAO_MODEL=
# DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# FRAMEWORK_SCAN_PLATFORMS=deepseek
# CITATION_SCAN_PLATFORMS=doubao,kimi
# CITATION_WEB_SEARCH=false
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-auto
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
# 通义 / 文心 / 元宝无 Open API Connector，走 C 端 Playwright（CEND_*）
# 真 Key 探针矩阵：GEOFLOW_LIVE_PROBE=1 ./scripts/smoke_probe_keys.sh
# 关 Mock 后全库重嵌：python scripts/reindex_all_knowledge.py

# Techstore 只读库：与本仓同一 Postgres 实例、另一 database（ADR-017）。空库导入为空；注释掉则走 fixture
TECHSTORE_DATABASE_URL=postgresql://geo_user:geo_password@postgres:5432/gweb_db
# 宿主机直连示例：postgresql://geo_user:geo_password@127.0.0.1:15433/gweb_db
# python scripts/import_techstore_knowledge.py

# 官方技术发布站 = GEOweb（Gweb 为独立项目前台，不在此对接）
GEOWEB_BASE_URL=http://127.0.0.1:3070
GEOWEB_SYNC_TOKEN=dev-geoweb-sync-token
GEOWEB_SYNC_ENABLED=true

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

API_PORT=18081
ADMIN_PORT=13001
